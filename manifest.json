{
  "manifest_version": 3,
  "name": "Redactron — Privacy-First Web Copilot",
  "version": "0.2.0",
  "description": "An AI copilot that guides you through any website's UI, redacting sensitive data on-device before anything reaches an LLM. Works with Gemini, Groq, or Claude.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/redaction.js", "src/pageStateExtractor.js", "src/actionGrounder.js", "src/content.js"],
      "css": ["src/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Redactron"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
